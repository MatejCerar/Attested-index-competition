node_modules/
lib/
out/
cache/
.env
*.log

# large raw source; catalog.js/json are the committed, derived universe
rwa-database.txt

# live competition output (regenerated each run)
app/public/data/live.json
broadcast/

# app build output (node_modules covered by the top-level rule)
app/dist/
app/tsconfig.tsbuildinfo

# filled TEE extension configs (secrets: keys + indexer DB creds); only the
# tee-extension/env/*.example templates are tracked
tee-extension/.env.coston2
tee-extension/env/.env.coston2
tee-extension/env/extension_proxy.coston2.docker.toml
tee-extension/**/extension_proxy.coston2.docker.toml

# python caches (deterministic-index)
__pycache__/
*.pyc
.pytest_cache/

# regenerated competition output (leaderboard is rewritten when the engine runs)
app/public/data/leaderboard.json

# docs: keep only README.md and ARCHITECTURE.md tracked; ignore other markdown
# (SPEC.md, CHANGELOG.md, DEPLOYMENT.md, DEPLOY.md, ...) so the commit is code
*.md
!README.md
!ARCHITECTURE.md
