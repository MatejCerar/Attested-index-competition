# Local dev: point the app at the local API server (scripts/server.mjs, :8787).
# generate.ts uses VITE_GENERATE_URL; add.ts uses VITE_API_URL. When the server
# is absent, generate falls back to the in-browser heuristic and add falls back
# to local-only state with a notice.
VITE_GENERATE_URL=http://localhost:8787/api/generate
VITE_API_URL=http://localhost:8787/api
