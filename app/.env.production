# Production build behind the deploy/Caddyfile reverse proxy: the app and the
# API share one origin, so the API is just a relative path. No public host to
# bake in. For a Cloudflare-hosted app talking to a separate API box, set these
# to the API's absolute https URL instead.
VITE_API_URL=/api
VITE_GENERATE_URL=/api/generate
VITE_BUILD_URL=/api/build
