# Single origin: the built app is served at /, the API is proxied at /api.
# Same-origin means the app uses relative VITE_API_URL=/api, so there is no
# build-time public URL to juggle and TLS is automatic. Replace the hostname.
index.example.com {
    encode gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8787
    }

    handle {
        root * /opt/index-competition/app/dist
        try_files {path} /index.html
        file_server
    }
}
