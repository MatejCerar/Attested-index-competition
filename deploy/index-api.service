[Unit]
Description=Index Competition API (scripts/server.mjs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/index-competition
EnvironmentFile=/etc/index-competition.env
ExecStart=/usr/bin/node scripts/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
