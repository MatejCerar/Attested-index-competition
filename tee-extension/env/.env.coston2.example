# .env.coston2 template for the INDEX/REBALANCE TEE extension.
#
# Copy to the scaffold root as `.env.coston2`. full-setup.sh --chain coston2
# copies this to `.env` automatically. Fill the two secrets and the two owner
# fields; leave the rest as-is unless you know why you are changing it.
#
# SECRETS ARE BLANK ON PURPOSE. Never commit the filled file (see .gitignore).
# No emojis, no em dashes (house style).

# Extension implementation language. Use "typescript" for this index extension
# (the rebalance handlers are TypeScript). Go is bit-for-bit reproducible;
# typescript targets same-machine determinism only (see REPRODUCIBILITY.md).
LANGUAGE=typescript

# Funded private key the proxy signs with (a Coston2-funded key is fine here).
PROXY_PRIVATE_KEY=""

# Coston2 deployer. INITIAL_OWNER must be the address derived from
# DEPLOYMENT_PRIVATE_KEY. Fund it with C2FLR from the Coston2 faucet.
INITIAL_OWNER=""
DEPLOYMENT_PRIVATE_KEY=""

# TEE governance signer set + threshold. If unset, defaults to
# GOVERNANCE_SIGNERS=<INITIAL_OWNER> and GOVERNANCE_THRESHOLD=1.
# GOVERNANCE_SIGNERS="0xAbc...,0xDef..."
# GOVERNANCE_THRESHOLD=2

# Coston2 RPC.
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc

# Coston2 deployed contract addresses shipped with the scaffold.
ADDRESSES_FILE=./config/coston2/deployed-addresses.json

# Must be false on live networks (Coston2 is live).
LOCAL_MODE=false

# TEE attestation mode. true = simulated attestation (test code hash/platform),
# no real TEE hardware. Set false only on a GCP Confidential Space VM.
SIMULATED_TEE=true

# Normal/FDC proxy URL on Coston2.
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# Extension proxy public URL. With --tunnel this is overwritten automatically
# from the cloudflared quick-tunnel URL. For ngrok, set it by hand.
# EXT_PROXY_URL=http://localhost:6674
EXT_PROXY_URL=""

# Cloudflare tunnel (docs/cloudflared.md). Quick tunnel by default, no account.
# For a durable demo use a NAMED tunnel = stable hostname:
# TUNNEL_ARGS=run --token eyJ...
# TUNNEL_TARGET=http://host.docker.internal:6664

# --- INDEX/REBALANCE enclave config -----------------------------------------
# The enclave-held rebalancer key. Its ADDRESS must equal StableIndexVault's
# `rebalancer` (constructor arg). In the FCC scaffold the key is generated INSIDE
# the TEE; you learn its address by probing /sign and deploy the vault with it as
# rebalancer. Leave BLANK here: never place the key in this file.
TEE_REBALANCER_KEY=""

# The vault the enclave will sign for. Set after you deploy StableIndexVault with
# the TEE address as rebalancer; the enclave refuses to sign for any other vault.
INDEX_VAULT=""

# The rebalancer address (== TEE signer == StableIndexVault.rebalancer). Filled
# from the /sign probe. Kept for reference / cross-check; not a secret.
INDEX_REBALANCER=""

# Coston2 chain id (signatures bind to this chain via the on-chain verifier).
INDEX_CHAIN_ID=114

# --- Optional docker-compose overrides (defaults are fine for Coston2) ---
# CHAIN_ID=114                 # Coston2 chain id
# LOG_LEVEL=INFO
# SOURCE_DATE_EPOCH=           # auto-derived from git by start-services.sh
